# Copy to .env and adjust. Leave keys empty for open local development.
SECRET_KEY=change-me-to-a-long-random-string

# Defaults match database/setup.sql + docker-compose.yml
DATABASE_URL=postgresql://incident:incident@localhost:5432/incidents
DATABASE_URL_READONLY=postgresql://incident_reader:reader@localhost:5432/incidents
DB_POOL_MAX=10

INPUT_KEY=
VIEW_KEY=
SQL_MAX_ROWS=2000
SQL_TIMEOUT_MS=3000
MAP_CENTER=52.52,13.405
MAP_ZOOM=11
